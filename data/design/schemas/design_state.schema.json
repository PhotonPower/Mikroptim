{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikroptim.design.state/1",
  "title": "Verdichteter Zustand eines Kandidaten für einen Entscheider (GUI-Ansicht und Eingabe des Sprachmodells)",
  "type": "object",
  "required": [
    "format",
    "candidate",
    "elements",
    "surfaces",
    "spec",
    "homotopy_point",
    "merit",
    "paraxial",
    "groups",
    "budget"
  ],
  "properties": {
    "format": {
      "const": "mikroptim.design.state/1"
    },
    "candidate": {
      "type": "integer"
    },
    "parent": {
      "type": [
        "integer",
        "null"
      ]
    },
    "elements": {
      "type": "integer"
    },
    "surfaces": {
      "type": "integer"
    },
    "spec": {
      "type": "object",
      "required": [
        "spectrum_nm"
      ],
      "properties": {
        "magnification": {
          "type": [
            "number",
            "null"
          ]
        },
        "na": {
          "type": [
            "number",
            "null"
          ]
        },
        "field_number": {
          "type": [
            "number",
            "null"
          ]
        },
        "tube_focal_length": {
          "type": [
            "number",
            "null"
          ]
        },
        "parfocal_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "immersion": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "spectrum_nm": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "target_color_class": {
          "enum": [
            "a",
            "b",
            "c",
            "d",
            "e",
            "f",
            "g",
            null
          ]
        },
        "target_field_class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "etendue": {
          "type": [
            "number",
            "null"
          ],
          "description": "G = π (y_obj NA)² in mm²"
        },
        "zone": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "homotopy_point": {
      "type": "object",
      "properties": {
        "aperture": {
          "type": [
            "number",
            "null"
          ]
        },
        "field": {
          "type": [
            "number",
            "null"
          ]
        },
        "spectrum_stage": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "merit": {
      "type": "object",
      "required": [
        "rms_max_waves",
        "failed_rays"
      ],
      "properties": {
        "F": {
          "type": [
            "number",
            "null"
          ]
        },
        "F_B": {
          "type": [
            "number",
            "null"
          ]
        },
        "F_G": {
          "type": [
            "number",
            "null"
          ]
        },
        "rms_max_waves": {
          "type": [
            "number",
            "null"
          ]
        },
        "rms_by_tuple": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "description": "Feldanteil"
              },
              {
                "type": "number",
                "description": "λ in nm"
              },
              {
                "type": "number",
                "description": "RMS in Wellen"
              }
            ]
          }
        },
        "failed_rays": {
          "type": "integer"
        },
        "lm_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "classes": {
      "type": [
        "object",
        "null"
      ]
    },
    "paraxial": {
      "type": "object",
      "properties": {
        "f": {
          "type": [
            "number",
            "null"
          ]
        },
        "working_distance": {
          "type": [
            "number",
            "null"
          ]
        },
        "petzval_radius": {
          "type": [
            "number",
            "null"
          ]
        },
        "retrofocus_factor": {
          "type": [
            "number",
            "null"
          ]
        },
        "kappa": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": {
          "$ref": "#/$defs/group_balance"
        },
        "middle": {
          "$ref": "#/$defs/group_balance"
        },
        "rear": {
          "$ref": "#/$defs/group_balance"
        }
      }
    },
    "top_contributors": {
      "type": "object",
      "description": "pro Größe die größten Beiträge als [Fläche, Wert in Wellen]",
      "additionalProperties": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "ghosts": {
      "type": [
        "object",
        "null"
      ],
      "description": "Auszug aus ghost_diagnosis_json"
    },
    "mechanics": {
      "type": "object",
      "properties": {
        "violations": {
          "type": "array"
        },
        "hemisphere_max": {
          "type": [
            "array",
            "null"
          ],
          "description": "[Fläche, h/R]"
        },
        "max_incidence_deg": {
          "type": "array",
          "description": "[Fläche, Grad]"
        }
      }
    },
    "sensitivity": {
      "type": [
        "object",
        "null"
      ]
    },
    "glasses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "integer"
          },
          "surface": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "nd": {
            "type": "number"
          },
          "vd": {
            "type": "number"
          },
          "dPgF": {
            "type": "number"
          },
          "af_forbidden": {
            "type": "boolean"
          }
        }
      }
    },
    "budget": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      }
    },
    "last_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "aberration_settings": {
      "type": "object",
      "description": "Wellenlängen, Feldwinkel und Vorzeichen des Aberrationsberichts"
    }
  },
  "$defs": {
    "group_balance": {
      "type": "object",
      "description": "Summen der Flächenbeiträge in Wellen bei λ_ref (Bezug volles Feld)",
      "properties": {
        "surfaces": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ]
        },
        "power": {
          "type": [
            "number",
            "null"
          ]
        },
        "petzval": {
          "type": [
            "number",
            "null"
          ]
        },
        "W040": {
          "type": [
            "number",
            "null"
          ]
        },
        "W040_higher": {
          "type": [
            "number",
            "null"
          ]
        },
        "zonal": {
          "type": [
            "number",
            "null"
          ]
        },
        "W131": {
          "type": [
            "number",
            "null"
          ]
        },
        "W222": {
          "type": [
            "number",
            "null"
          ]
        },
        "W220": {
          "type": [
            "number",
            "null"
          ]
        },
        "W311": {
          "type": [
            "number",
            "null"
          ]
        },
        "dW020": {
          "type": [
            "number",
            "null"
          ]
        },
        "dW111": {
          "type": [
            "number",
            "null"
          ]
        },
        "sphchrom": {
          "type": [
            "number",
            "null"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  }
}
