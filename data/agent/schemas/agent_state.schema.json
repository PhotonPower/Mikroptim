{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikroptim.agent.state/1",
  "title": "Verdichteter Zustand eines Kandidaten für das Sprachmodell",
  "type": "object",
  "required": ["format", "candidate", "elements", "surfaces", "spec", "homotopy_point", "merit", "paraxial", "groups", "budget"],
  "properties": {
    "format": {"const": "mikroptim.agent.state/1"},
    "candidate": {"type": "integer"}, "parent": {"type": ["integer", "null"]},
    "elements": {"type": "integer"}, "surfaces": {"type": "integer"},
    "spec": {"type": "object", "required": ["magnification", "na", "field_number", "tube_focal_length", "spectrum_nm"],
      "properties": {
        "magnification": {"type": "number"}, "na": {"type": "number"}, "field_number": {"type": "number"},
        "tube_focal_length": {"type": "number"}, "parfocal_max": {"type": "number"},
        "immersion": {"type": "boolean"}, "spectrum_nm": {"type": "array", "items": {"type": "number"}},
        "target_color_class": {"enum": ["a", "b", "c", "d", "e", "f", "g"]},
        "target_field_class": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "etendue": {"type": "number", "description": "G = π (y_obj NA)² in mm²"},
        "zone": {"type": "integer", "minimum": 1, "maximum": 6}}},
    "homotopy_point": {"type": "object", "properties": {"aperture": {"type": "number"}, "field": {"type": "number"}, "spectrum_stage": {"type": "integer"}}},
    "merit": {"type": "object", "required": ["F", "F_B", "rms_max_waves", "failed_rays"],
      "properties": {"F": {"type": "number"}, "F_B": {"type": "number"}, "F_G": {"type": "number"},
        "rms_max_waves": {"type": "number"},
        "rms_by_tuple": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number", "description": "Feldanteil"}, {"type": "number", "description": "λ in nm"}, {"type": "number", "description": "RMS in Wellen"}]}},
        "failed_rays": {"type": "integer"}, "lm_status": {"type": "string"}}},
    "classes": {"type": "object", "properties": {"color": {"enum": ["none", "a", "b", "c", "d", "e", "f", "g"]},
      "field": {"type": "integer", "minimum": 1, "maximum": 7}, "vignetting": {"type": "number"}}},
    "paraxial": {"type": "object", "properties": {"f": {"type": "number"}, "working_distance": {"type": "number"},
      "petzval_radius": {"type": "number"}, "retrofocus_factor": {"type": "number"}, "kappa": {"type": "number"}}},
    "groups": {"type": "object", "additionalProperties": false,
      "properties": {"front": {"$ref": "#/$defs/group_balance"}, "middle": {"$ref": "#/$defs/group_balance"}, "rear": {"$ref": "#/$defs/group_balance"}}},
    "top_contributors": {"type": "object", "description": "pro Größe die größten Beiträge als [Fläche, Wert in Wellen]",
      "additionalProperties": {"type": "array", "maxItems": 8, "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "number"}]}}},
    "ghosts": {"type": "object", "description": "Auszug aus ghost_diagnosis_json"},
    "mechanics": {"type": "object", "properties": {"violations": {"type": "array"},
      "hemisphere_max": {"type": "array", "description": "[Fläche, h/R]"}, "max_incidence_deg": {"type": "array", "description": "[Fläche, Grad]"}}},
    "sensitivity": {"type": "object", "additionalProperties": {"type": "array"}},
    "glasses": {"type": "array", "items": {"type": "object", "properties": {"element": {"type": "integer"}, "surface": {"type": "integer"},
      "name": {"type": "string"}, "nd": {"type": "number"}, "vd": {"type": "number"}, "dPgF": {"type": "number"}, "af_forbidden": {"type": "boolean"}}}},
    "budget": {"type": "object", "properties": {"actions_left": {"type": "integer"}, "elements_max": {"type": "integer"}, "surfaces_max": {"type": "integer"}}},
    "history": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
    "last_errors": {"type": "array", "items": {"type": "object", "properties": {"action": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}}}}
  },
  "$defs": {
    "group_balance": {"type": "object", "description": "Summen der Flächenbeiträge in Wellen bei λ_ref (Bezug volles Feld)",
      "properties": {"surfaces": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}]},
        "power": {"type": "number"}, "petzval": {"type": "number"},
        "W040": {"type": "number"}, "W040_higher": {"type": "number"}, "zonal": {"type": "number"},
        "W131": {"type": "number"}, "W222": {"type": "number"}, "W220": {"type": "number"}, "W311": {"type": "number"},
        "dW020": {"type": "number"}, "dW111": {"type": "number"}, "sphchrom": {"type": "number"}}}
  }
}
