{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mikroptim.agent.action/1",
  "title": "Antwort des Sprachmodells: 1–4 Aktionen mit Begründung",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "candidate", "assessment", "actions"],
  "properties": {
    "format": {"const": "mikroptim.agent.action/1"},
    "candidate": {"type": "integer", "minimum": 0, "description": "Kandidat, auf den sich die Aktionen beziehen"},
    "assessment": {"type": "string", "maxLength": 600, "description": "Kurze Einschätzung der Gruppenbilanz: was fehlt, wo"},
    "actions": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "reason": {"type": "string", "maxLength": 300, "description": "Welche Bilanz/Aberration die Aktion ändern soll"},
    "surface": {"type": "integer", "minimum": 0, "maximum": 63},
    "element": {"type": "integer", "minimum": 0},
    "group": {"enum": ["front", "middle", "rear"]},
    "glass_filter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rule": {"enum": ["selectable_pgf", "merte_pair", "front_medium_n_medium_vd", "low_n_low_dispersion",
                          "dense_flint_for_lca", "buried_surface", "not_af_forbidden"]},
        "partner_of_element": {"type": "integer", "minimum": 0},
        "nd": {"$ref": "#/$defs/range"}, "vd": {"$ref": "#/$defs/range"}, "dPgF": {"$ref": "#/$defs/range"},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "glass_choice": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["filter"], "properties": {"filter": {"$ref": "#/$defs/glass_filter"}}}
      ]
    },
    "range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/get_surface_table"}, {"$ref": "#/$defs/get_ghost_diagnosis"}, {"$ref": "#/$defs/evaluate"},
        {"$ref": "#/$defs/sensitivity"}, {"$ref": "#/$defs/glass_query"}, {"$ref": "#/$defs/module_lookup"},
        {"$ref": "#/$defs/optimize"}, {"$ref": "#/$defs/synth_segment"}, {"$ref": "#/$defs/penalty_continuation"},
        {"$ref": "#/$defs/snap_glasses"}, {"$ref": "#/$defs/free_gaps"}, {"$ref": "#/$defs/freeze"},
        {"$ref": "#/$defs/set_bounds"}, {"$ref": "#/$defs/set_constraint"}, {"$ref": "#/$defs/set_homotopy_plan"},
        {"$ref": "#/$defs/place_ghost_dictionary"}, {"$ref": "#/$defs/scale_ghost_penalty"},
        {"$ref": "#/$defs/insert_null_meniscus"}, {"$ref": "#/$defs/split_lens"}, {"$ref": "#/$defs/insert_module"},
        {"$ref": "#/$defs/remove_element"}, {"$ref": "#/$defs/replace_glass"}, {"$ref": "#/$defs/replace_group"},
        {"$ref": "#/$defs/start_from_skeleton"}, {"$ref": "#/$defs/branch"}, {"$ref": "#/$defs/abandon"},
        {"$ref": "#/$defs/finish"}
      ]
    },

    "get_surface_table": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "get_surface_table"},
        "quantities": {"type": "array", "items": {"enum": ["paraxial", "seidel", "full_sa", "zonal_sa", "sphchrom", "extrema"]}},
        "surfaces": {"$ref": "#/$defs/range"}, "reason": {"$ref": "#/$defs/reason"}}},
    "get_ghost_diagnosis": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "get_ghost_diagnosis"}, "reason": {"$ref": "#/$defs/reason"}}},
    "evaluate": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "evaluate"}, "grid": {"enum": [64, 128, 256]}, "psf": {"type": "boolean"},
        "reference": {"enum": ["exit_pupil", "vertex"]}, "reason": {"$ref": "#/$defs/reason"}}},
    "sensitivity": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "sensitivity"},
        "kinds": {"type": "array", "items": {"enum": ["decenter", "tilt", "radius", "thickness", "index"]}},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}, "reason": {"$ref": "#/$defs/reason"}}},
    "glass_query": {"type": "object", "additionalProperties": false, "required": ["action", "filter"],
      "properties": {"action": {"const": "glass_query"}, "filter": {"$ref": "#/$defs/glass_filter"}, "reason": {"$ref": "#/$defs/reason"}}},
    "module_lookup": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "module_lookup"}, "group": {"$ref": "#/$defs/group"},
        "corrects": {"type": "array", "items": {"enum": ["SA", "ZSA", "coma", "AST", "FC", "ACA", "LCA", "SPHCRM"]}},
        "reason": {"$ref": "#/$defs/reason"}}},

    "optimize": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "optimize"}, "cycles": {"type": "integer", "minimum": 10, "maximum": 2000},
        "variables": {"enum": ["current", "all_curvatures", "curvatures_and_gaps", "everything"]},
        "jacobian": {"enum": ["fd", "adjoint"]}, "reason": {"$ref": "#/$defs/reason"}}},
    "synth_segment": {"type": "object", "additionalProperties": false, "required": ["action", "target"],
      "properties": {"action": {"const": "synth_segment"},
        "target": {"type": "object", "additionalProperties": false,
          "properties": {"aperture": {"type": "number", "minimum": 0.01, "maximum": 0.99},
                         "field": {"type": "number", "minimum": 0, "maximum": 1},
                         "spectrum_stage": {"type": "integer", "minimum": 0}}},
        "beam_width": {"type": "integer", "minimum": 1, "maximum": 8},
        "alternatives": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_new_elements": {"type": "integer", "minimum": 0, "maximum": 4}, "reason": {"$ref": "#/$defs/reason"}}},
    "penalty_continuation": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "penalty_continuation"}, "stages": {"type": "integer", "minimum": 1, "maximum": 6},
        "factor": {"type": "number", "minimum": 2, "maximum": 100}, "reason": {"$ref": "#/$defs/reason"}}},
    "snap_glasses": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "snap_glasses"}, "k": {"type": "integer", "minimum": 1, "maximum": 6},
        "max_combinations": {"type": "integer", "minimum": 1, "maximum": 512}, "reason": {"$ref": "#/$defs/reason"}}},

    "free_gaps": {"type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "free_gaps"}, "surfaces": {"oneOf": [{"const": "all"}, {"type": "array", "items": {"$ref": "#/$defs/surface"}}]},
        "include_glass_thickness": {"type": "boolean"}, "max_gap": {"type": "number", "minimum": 0.1, "maximum": 40},
        "reason": {"$ref": "#/$defs/reason"}}},
    "freeze": {"type": "object", "additionalProperties": false, "required": ["action", "variables"],
      "properties": {"action": {"const": "freeze"}, "variables": {"type": "array", "items": {"type": "string", "description": "Variablenname wie im Bericht, z. B. c[7], t[3], n0[5]"}},
        "reason": {"$ref": "#/$defs/reason"}}},
    "set_bounds": {"type": "object", "additionalProperties": false, "required": ["action", "variable"],
      "properties": {"action": {"const": "set_bounds"}, "variable": {"type": "string"}, "min": {"type": "number"}, "max": {"type": "number"},
        "reason": {"$ref": "#/$defs/reason"}}},
    "set_constraint": {"type": "object", "additionalProperties": false, "required": ["action", "type"],
      "properties": {"action": {"const": "set_constraint"},
        "type": {"enum": ["petzval", "working_distance", "parfocal_length", "min_edge_thickness", "min_center_thickness", "max_incidence_angle", "max_semi_diameter"]},
        "limit": {"type": "number"}, "mode": {"enum": ["equal", "min", "max"]}, "weight": {"type": "number", "exclusiveMinimum": 0},
        "enabled": {"type": "boolean"}, "reason": {"$ref": "#/$defs/reason"}}},
    "set_homotopy_plan": {"type": "object", "additionalProperties": false, "required": ["action", "stages"],
      "properties": {"action": {"const": "set_homotopy_plan"},
        "stages": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false,
          "required": ["aperture", "field", "spectrum_stage"],
          "properties": {"aperture": {"type": "number"}, "field": {"type": "number"}, "spectrum_stage": {"type": "integer"},
                         "petzval": {"type": "boolean"}}}},
        "reason": {"$ref": "#/$defs/reason"}}},
    "place_ghost_dictionary": {"type": "object", "additionalProperties": false, "required": ["action", "after_surface", "distance"],
      "properties": {"action": {"const": "place_ghost_dictionary"}, "after_surface": {"$ref": "#/$defs/surface"},
        "distance": {"type": "number", "minimum": 0}, "glasses": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
        "max_order": {"type": "integer", "minimum": 2, "maximum": 12}, "reason": {"$ref": "#/$defs/reason"}}},
    "scale_ghost_penalty": {"type": "object", "additionalProperties": false, "required": ["action", "plate", "factor"],
      "properties": {"action": {"const": "scale_ghost_penalty"}, "plate": {"type": "integer", "minimum": 0},
        "factor": {"type": "number", "minimum": 0.1, "maximum": 100}, "reason": {"$ref": "#/$defs/reason"}}},

    "insert_null_meniscus": {"type": "object", "additionalProperties": false, "required": ["action", "after_surface", "glass"],
      "properties": {"action": {"const": "insert_null_meniscus"}, "after_surface": {"$ref": "#/$defs/surface"},
        "position": {"type": "number", "minimum": 0}, "glass": {"$ref": "#/$defs/glass_choice"},
        "curvature": {"oneOf": [{"type": "number"}, {"type": "object", "additionalProperties": false, "required": ["from_surface"], "properties": {"from_surface": {"$ref": "#/$defs/surface"}}}]},
        "saddle_branches": {"type": "boolean"}, "group": {"$ref": "#/$defs/group"}, "reason": {"$ref": "#/$defs/reason"}}},
    "split_lens": {"type": "object", "additionalProperties": false, "required": ["action", "element"],
      "properties": {"action": {"const": "split_lens"}, "element": {"$ref": "#/$defs/element"},
        "fraction": {"type": "number", "minimum": 0.1, "maximum": 0.9},
        "cement_curvature": {"oneOf": [{"enum": ["achromat", "mean"]}, {"type": "number"}]},
        "free_part": {"enum": [0, 1]}, "target_glass": {"$ref": "#/$defs/glass_choice"}, "reason": {"$ref": "#/$defs/reason"}}},
    "insert_module": {"type": "object", "additionalProperties": false, "required": ["action", "module", "after_surface"],
      "properties": {"action": {"const": "insert_module"}, "module": {"type": "string", "description": "ID aus modules.json, z. B. front.shell_ca"},
        "after_surface": {"$ref": "#/$defs/surface"}, "position": {"type": "number", "minimum": 0},
        "glasses": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/glass_choice"}},
        "group": {"$ref": "#/$defs/group"}, "reason": {"$ref": "#/$defs/reason"}}},
    "remove_element": {"type": "object", "additionalProperties": false, "required": ["action", "element"],
      "properties": {"action": {"const": "remove_element"}, "element": {"$ref": "#/$defs/element"}, "reason": {"$ref": "#/$defs/reason"}}},
    "replace_glass": {"type": "object", "additionalProperties": false, "required": ["action", "element", "glass"],
      "properties": {"action": {"const": "replace_glass"}, "element": {"$ref": "#/$defs/element"}, "glass": {"$ref": "#/$defs/glass_choice"},
        "reason": {"$ref": "#/$defs/reason"}}},
    "replace_group": {"type": "object", "additionalProperties": false, "required": ["action", "group", "modules"],
      "properties": {"action": {"const": "replace_group"}, "group": {"$ref": "#/$defs/group"},
        "modules": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}}, "reason": {"$ref": "#/$defs/reason"}}},
    "start_from_skeleton": {"type": "object", "additionalProperties": false, "required": ["action", "power_distribution", "front", "middle", "rear"],
      "properties": {"action": {"const": "start_from_skeleton"},
        "power_distribution": {"enum": ["PPN", "PPN_strong_retrofocus", "PP(NP)", "P(PN)0", "P(P0)N", "(P0)PN", "P(P0P)N", "double_gauss", "PNP"],
          "description": "Typen nach Zhang Tab. 6.2 bzw. Zone 5"},
        "front": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}},
        "middle": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
        "rear": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
        "start_aperture": {"type": "number", "minimum": 0.1, "maximum": 0.9}, "reason": {"$ref": "#/$defs/reason"}}},

    "branch": {"type": "object", "additionalProperties": false, "required": ["action", "alternatives"],
      "properties": {"action": {"const": "branch"},
        "alternatives": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "object", "description": "eine Aktion (ohne branch/abandon/finish) wie oben; der Executor validiert jede Alternative einzeln gegen #/$defs/action", "required": ["action"]}}},
        "reason": {"$ref": "#/$defs/reason"}}},
    "abandon": {"type": "object", "additionalProperties": false, "required": ["action", "reason"],
      "properties": {"action": {"const": "abandon"}, "reason": {"$ref": "#/$defs/reason"}}},
    "finish": {"type": "object", "additionalProperties": false, "required": ["action", "reason"],
      "properties": {"action": {"const": "finish"}, "reason": {"$ref": "#/$defs/reason"}}}
  }
}
